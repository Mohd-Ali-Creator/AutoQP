# ============================================================
# AutoQP Environment Variables
# Copy this to .env.local in apps/web or at root
# ============================================================

# Supabase (find these in your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Google Gemini API (used by Track 2 for generation & multimodal extraction)
GEMINI_API_KEY="your-gemini-api-key-here"
